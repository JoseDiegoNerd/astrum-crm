{
  "name": "@astrum/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrum/db": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "4.1.12"
  }
}
