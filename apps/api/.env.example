PORT=3333
# Local (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Produção: string do pooler em modo transação (porta 6543) do painel do Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Só se o projeto ainda assina tokens com HS256 (segredo legado). Com chaves
# assimétricas (padrão em projetos novos) deixe vazio: a API usa o JWKS.
SUPABASE_JWT_SECRET=
WEB_ORIGIN=http://localhost:3000

# F2 · canais (WhatsApp etc.)
# Chave que cifra tokens e segredos dos canais no banco. Gere uma por ambiente:
#   openssl rand -base64 32
# Nunca reutilize a de produção em outro ambiente nem a coloque no repositório.
CHANNEL_SECRETS_KEY=
WHATSAPP_GRAPH_VERSION=v24.0
# Novas tentativas da fila de entrada (ms); 0 desliga
INBOUND_POLL_MS=5000
# Endereço público da API (a URL do webhook cadastrada na Meta usa este endereço)
PUBLIC_API_URL=http://localhost:3333
